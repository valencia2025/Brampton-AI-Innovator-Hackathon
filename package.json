{
  "name": "brampton-content-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "vite build",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.ts",
    "check": "tsc --noEmit",
    "verify": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.5",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  }
}
